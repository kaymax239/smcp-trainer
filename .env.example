# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está en .gitignore: nunca se commitea.

# Clave de VesselAPI (AIS en vivo) para /api/traffic.
# Si falta, /api/traffic cae al snapshot data/scenarios/tampico-watch-01.json.
VESSELAPI_KEY=

# Clave de Google Gemini para el calificador de tareas (/api/feedback).
GEMINI_API_KEY=

# Modelo de Gemini a usar (opcional; por defecto gemini-2.5-flash).
GEMINI_MODEL=

# Google OAuth (Auth.js / NextAuth v5) para el login restringido a @fidena.edu.mx.
# El Client ID y el Client Secret salen de Google Cloud Console > Credentials.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Secreto para firmar la sesión. Genera uno con: npx auth secret  (o openssl rand -base64 32)
AUTH_SECRET=
